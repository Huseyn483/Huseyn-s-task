@using MvcDewiCRUD.Areas.AdminPanel.ViewModel
@model CreateVM
<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Create Member</h4>
        
                <form class="forms-sample" method="post">
                    <div class="form-group">
                        <label asp-for="PhotoUrl" >Image</label>
                        <input class="form-control" placeholder="Image" asp-for="PhotoUrl">
                        <span asp-validation-for="PhotoUrl"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Name">Name</label>
                        <input class="form-control" placeholder="Name" asp-for="Name">
                        <span asp-validation-for="Name"></span>
                    </div>
                    <div class="form-group">
                        <label <label asp-for="Description" >Description</label>
                        <input  class="form-control"  placeholder="Description" asp-for="Description">
                        <span asp-validation-for="Description"></span>
                    </div>
                   
                    <button type="submit" class="btn btn-primary me-2" >Create</button>
                    <a class="btn btn-light" asp-controller="Member" asp-action="Index">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>